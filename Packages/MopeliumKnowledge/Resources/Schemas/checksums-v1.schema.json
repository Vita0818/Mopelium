{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mopelium.local/knowledge/checksums-v1.schema.json",
  "title": "Mopelium RAG leaf integrity inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "algorithm",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "mopelium-rag-checksums/1"
    },
    "algorithm": {
      "const": "sha256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.mopelium-rag/checksums\\.json$)[A-Za-z0-9._~!$&'()+,;=@%/-]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "role": {
            "enum": [
              "okf",
              "concept",
              "reference",
              "profile",
              "chunk_manifest",
              "dense_index",
              "lexical_index",
              "auxiliary"
            ]
          }
        }
      }
    }
  }
}
