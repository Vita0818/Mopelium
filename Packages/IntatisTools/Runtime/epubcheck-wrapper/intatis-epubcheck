#!/bin/sh

set -eu

case "$0" in
    /*) wrapper_path=$0 ;;
    *) wrapper_path=$(pwd -P)/$0 ;;
esac

runtime_bin=$(dirname -- "$wrapper_path")
runtime_root=$(CDPATH= cd -- "$runtime_bin/.." && pwd -P)
distribution="$runtime_root/lib/epubcheck-5.3.0"
jar="$distribution/epubcheck.jar"
bundled_java="$runtime_root/jre/temurin-21.0.11+10/Contents/Home/bin/java"
is_shipping_runtime=0
case "$runtime_root" in
    *.app/Contents/Resources/DocumentRuntime/arm64|\
    *.app/Contents/Resources/DocumentRuntime/x86_64)
        is_shipping_runtime=1
        ;;
esac

if [ ! -r "$jar" ]; then
    printf '%s\n' 'Intatis EPUBCheck 5.3.0 runtime is incomplete' >&2
    exit 69
fi

if [ -x "$bundled_java" ]; then
    java="$bundled_java"
elif [ "$is_shipping_runtime" -eq 1 ]; then
    printf '%s\n' 'Intatis EPUBCheck shipping Java runtime is unavailable' >&2
    exit 69
elif [ -x /usr/bin/java ]; then
    # Development compatibility only. A release runtime is rejected unless
    # the architecture root contains its own fixed Java executable.
    java=/usr/bin/java
else
    printf '%s\n' 'Intatis EPUBCheck Java runtime is unavailable' >&2
    exit 69
fi

exec "$java" -Djava.awt.headless=true -jar "$jar" "$@"
