# SwiftPM
.build/
.swiftpm/

# Keep the root lockfile tracked so audited renderer dependencies stay exact.

# Xcode
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
dist/
*.xcuserstate

# Generated by XcodeGen (run `make app` / `xcodegen generate` to recreate)
Mopelium.xcodeproj/
# Pre-migration generated project; never adopt it as a second build graph.
Intatis.xcodeproj/

# macOS
.DS_Store

# Mopelium local runtime/worktree state
.mopelium/
# Predecessor state remains ignored while the bounded migration reader exists.
.intatis/

# Secrets / local config (never commit)
*.env
.env
secrets.json
Config.local.*
